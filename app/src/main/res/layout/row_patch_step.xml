<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp">
    <ImageView android:id="@+id/rowIcon"
        android:layout_width="22dp" android:layout_height="22dp"
        android:src="@drawable/ic_clock" />
    <TextView android:id="@+id/rowLabel"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:text="—" android:textColor="@color/text_mid"
        android:textSize="14sp" android:paddingStart="12dp" />
    <TextView android:id="@+id/rowStatus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/status_pending" android:textColor="@color/muted"
        android:textSize="12sp" android:fontFamily="monospace" />
</LinearLayout>
