<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg" android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/settingsBack" android:layout_width="42dp" android:layout_height="42dp"
            android:padding="10dp" android:src="@drawable/ic_back" />
        <TextView android:text="@string/settings" android:textColor="@color/text" android:textSize="23sp"
            android:fontFamily="sans-serif-black" android:paddingStart="8dp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
    </LinearLayout>

    <TextView android:text="GENERAL" android:textColor="@color/muted" android:textSize="10sp"
        android:textAllCaps="true" android:letterSpacing="0.10"
        android:layout_marginTop="18dp" android:layout_marginBottom="7dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/card_bg"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center_vertical">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:text="@string/auto_menu" android:textColor="@color/text" android:textSize="13sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:text="@string/auto_menu_sub" android:textColor="@color/muted" android:textSize="10sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <Switch android:id="@+id/settingAutoMenus" android:checked="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/card_bg"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:text="@string/keep_awake" android:textColor="@color/text" android:textSize="13sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:text="@string/keep_awake_sub" android:textColor="@color/muted" android:textSize="10sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <Switch android:id="@+id/settingKeepAwake"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView android:text="INSTALLATION" android:textColor="@color/muted" android:textSize="10sp"
        android:textAllCaps="true" android:letterSpacing="0.10"
        android:layout_marginTop="16dp" android:layout_marginBottom="7dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/card_bg"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center_vertical">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:text="@string/confirm_install" android:textColor="@color/text" android:textSize="13sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:text="@string/confirm_install_sub" android:textColor="@color/muted" android:textSize="10sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <Switch android:id="@+id/settingInstallConfirm" android:checked="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView android:text="LANGUAGE" android:textColor="@color/muted" android:textSize="10sp"
        android:textAllCaps="true" android:letterSpacing="0.10"
        android:layout_marginTop="16dp" android:layout_marginBottom="7dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <LinearLayout android:id="@+id/settingsLanguage"
        android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/card_bg"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:gravity="center_vertical"
        android:clickable="true" android:focusable="true">
        <TextView android:text="@string/language" android:textColor="@color/text" android:textSize="13sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/currentLanguage" android:text="English" android:textColor="@color/muted"
            android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <ImageView android:src="@drawable/ic_arrow" android:layout_width="18dp" android:layout_height="18dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView android:text="APK Patcher · v1.0.0" android:textColor="@color/muted" android:textSize="10sp"
        android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
