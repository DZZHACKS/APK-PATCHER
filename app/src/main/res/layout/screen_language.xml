<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg" android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/languageBack" android:layout_width="42dp" android:layout_height="42dp"
            android:padding="10dp" android:src="@drawable/ic_back" />
        <TextView android:text="@string/language_title" android:textColor="@color/text" android:textSize="23sp"
            android:fontFamily="sans-serif-black" android:paddingStart="8dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView android:text="LANGUAGE" android:textColor="@color/muted" android:textSize="10sp"
        android:textAllCaps="true" android:letterSpacing="0.10" android:layout_marginTop="18dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />

    <LinearLayout android:id="@+id/langEnglish" android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="8dp" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:gravity="center_vertical" android:background="@drawable/pill_surface"
        android:clickable="true" android:focusable="true">
        <TextView android:text="🇬🇧" android:textSize="20sp" android:layout_width="38dp" android:layout_height="wrap_content" />
        <TextView android:text="English" android:textColor="@color/text" android:textSize="14sp" android:fontFamily="sans-serif-medium"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/langEnglishCheck" android:text="✓" android:textColor="@color/accent" android:textSize="18sp" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:id="@+id/langSpanish" android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="6dp" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:gravity="center_vertical" android:background="@drawable/pill_surface"
        android:clickable="true" android:focusable="true">
        <TextView android:text="🇪🇸" android:textSize="20sp" android:layout_width="38dp" android:layout_height="wrap_content" />
        <TextView android:text="Español" android:textColor="@color/text" android:textSize="14sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/langSpanishCheck" android:text="✓" android:textColor="@color/accent" android:textSize="18sp" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:id="@+id/langFrench" android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="6dp" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:gravity="center_vertical" android:background="@drawable/pill_surface"
        android:clickable="true" android:focusable="true">
        <TextView android:text="🇫🇷" android:textSize="20sp" android:layout_width="38dp" android:layout_height="wrap_content" />
        <TextView android:text="Français" android:textColor="@color/text" android:textSize="14sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/langFrenchCheck" android:text="✓" android:textColor="@color/accent" android:textSize="18sp" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:id="@+id/langRussian" android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="6dp" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:gravity="center_vertical" android:background="@drawable/pill_surface"
        android:clickable="true" android:focusable="true">
        <TextView android:text="🇷🇺" android:textSize="20sp" android:layout_width="38dp" android:layout_height="wrap_content" />
        <TextView android:text="Русский" android:textColor="@color/text" android:textSize="14sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/langRussianCheck" android:text="✓" android:textColor="@color/accent" android:textSize="18sp" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:id="@+id/langPortuguese" android:layout_width="match_parent" android:layout_height="58dp"
        android:layout_marginTop="6dp" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:gravity="center_vertical" android:background="@drawable/pill_surface"
        android:clickable="true" android:focusable="true">
        <TextView android:text="🇧🇷" android:textSize="20sp" android:layout_width="38dp" android:layout_height="wrap_content" />
        <TextView android:text="Português (Brasil)" android:textColor="@color/text" android:textSize="14sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/langPortugueseCheck" android:text="✓" android:textColor="@color/accent" android:textSize="18sp" android:visibility="gone"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
