<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:paddingHorizontal="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/create_keystore" android:textColor="@color/text"
        android:textSize="20sp" android:fontFamily="sans-serif-medium" />
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/keystore_format"
        android:textColor="@color/muted" android:textSize="12sp"
        android:paddingTop="2dp" android:paddingBottom="18dp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/field_name"
        android:layout_marginBottom="10dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ksName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/field_password"
        app:endIconMode="password_toggle"
        android:layout_marginBottom="10dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ksPass"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/field_alias"
        android:layout_marginBottom="4dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ksAlias"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/ksRegen"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/regenerate_password"
        android:textColor="@color/accent" android:textSize="12sp"
        android:paddingVertical="8dp"
        android:background="?android:selectableItemBackground"
        android:clickable="true" android:focusable="true" />
</LinearLayout>
