<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:background="@color/bg" android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/aboutBack" android:layout_width="42dp" android:layout_height="42dp"
            android:padding="10dp" android:src="@drawable/ic_back" />
        <TextView android:text="@string/about_title" android:textColor="@color/text" android:textSize="23sp"
            android:fontFamily="sans-serif-black" android:paddingStart="8dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <FrameLayout android:layout_width="82dp" android:layout_height="82dp" android:background="@drawable/success_circle">
        <ImageView android:src="@drawable/ic_bolt" android:layout_width="42dp" android:layout_height="42dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView android:text="@string/app_name" android:textColor="@color/text" android:textSize="28sp"
        android:fontFamily="sans-serif-black" android:layout_marginTop="16dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="@string/app_subtitle" android:textColor="@color/muted" android:textSize="13sp"
        android:layout_marginTop="3dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="@string/about_version" android:textColor="@color/text" android:textSize="12sp"
        android:layout_marginTop="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="@string/about_body" android:textColor="@color/muted" android:textSize="11sp"
        android:gravity="center" android:layout_marginTop="10dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
