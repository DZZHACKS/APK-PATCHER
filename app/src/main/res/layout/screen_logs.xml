<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg" android:padding="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/logsBack" android:layout_width="42dp" android:layout_height="42dp"
            android:padding="10dp" android:src="@drawable/ic_back" />
        <TextView android:text="@string/logs_title" android:textColor="@color/text" android:textSize="23sp"
            android:fontFamily="sans-serif-black" android:paddingStart="8dp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
        <TextView android:id="@+id/clearLogs" android:text="@string/logs_clear" android:textColor="@color/accent"
            android:textSize="12sp" android:paddingHorizontal="12dp" android:paddingVertical="8dp"
            android:background="@drawable/pill_surface" android:clickable="true" android:focusable="true"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="12dp"
        android:background="@drawable/card_bg" android:padding="14dp">
        <TextView android:id="@+id/logText" android:textColor="@color/text" android:textSize="11sp"
            android:fontFamily="monospace" android:textIsSelectable="true" android:text="@string/logs_empty"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
    </ScrollView>
</LinearLayout>
