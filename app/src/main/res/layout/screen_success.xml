<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingHorizontal="20dp"
    android:paddingTop="22dp"
    android:paddingBottom="22dp"
    android:gravity="center_horizontal">

    <FrameLayout android:layout_width="120dp" android:layout_height="120dp" android:layout_marginTop="40dp">
        <View android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/success_glow" />
        <View android:layout_width="90dp" android:layout_height="90dp" android:layout_gravity="center"
            android:background="@drawable/success_circle" />
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
            android:src="@drawable/ic_check" />
    </FrameLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/patch_ok" android:textColor="@color/text"
        android:textSize="26sp" android:fontFamily="sans-serif-black" android:paddingTop="18dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/patch_ok_sub" android:textColor="@color/muted" android:gravity="center"
        android:textSize="13sp" android:paddingTop="6dp" android:paddingBottom="22dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/card_bg" android:padding="14dp" android:layout_marginBottom="18dp">
        <FrameLayout android:id="@+id/okGameBadge"
            android:layout_width="52dp" android:layout_height="52dp"
            android:background="@drawable/badge_bg">
            <TextView android:id="@+id/okGameCode" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:textColor="#FFFFFF" android:text="OK"
                android:textSize="13sp" android:fontFamily="sans-serif-black" />
            <ImageView android:id="@+id/okGameLogo"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/okGameName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/text" android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/okFileName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/muted" android:textSize="11sp" />
            <TextView android:id="@+id/okFileSize" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/muted_dim" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/btnInstall"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center"
        android:background="@drawable/pill_accent" android:layout_marginBottom="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_install" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/install_apk" android:textColor="#FFFFFF" android:textSize="15sp"
            android:fontFamily="sans-serif-medium" android:paddingStart="10dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/btnShare"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center"
        android:background="@drawable/pill_surface" android:layout_marginBottom="10dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_share" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/share" android:textColor="@color/text" android:textSize="14sp"
            android:paddingStart="10dp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/btnOpenFolder"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center"
        android:background="@drawable/pill_surface" android:layout_marginBottom="14dp"
        android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_folder" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/open_folder" android:textColor="@color/text" android:textSize="14sp"
            android:paddingStart="10dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/card_bg" android:padding="12dp">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_check" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/apk_ready_hint" android:textColor="@color/success"
            android:textSize="12sp" android:paddingStart="10dp" />
    </LinearLayout>
</LinearLayout>
